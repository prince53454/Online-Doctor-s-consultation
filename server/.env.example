# ==========================================
# MediConnect Pro — Environment Variables
# Copy this file to .env and fill in your values
# ==========================================

# ── Server ────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ───────────────────────────────
MONGODB_URI=mongodb://localhost:27017/mediconnect_pro

# ── Authentication ────────────────────────
JWT_SECRET=your_jwt_secret_here_make_it_long_and_random
JWT_EXPIRE=30d

# ── Client URL (for CORS & email links) ──
CLIENT_URL=http://localhost:3000

# ── Razorpay (Payments) ───────────────────
# Get keys from https://dashboard.razorpay.com/
# Leave as-is for mock/testing mode
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── Stripe (Payments - Alternative) ───────
# Get keys from https://dashboard.stripe.com/
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# ── Email (SMTP) ──────────────────────────
# Gmail: use app-specific password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=MediConnect Pro <noreply@yourdomain.com>

# ── Cloudinary (File Uploads) ─────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Daily.co (Video Calls) ────────────────
DAILY_API_KEY=your_daily_api_key
DAILY_API_SECRET=your_daily_api_secret
