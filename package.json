{
  "name": "mediconnect-pro",
  "version": "1.0.0",
  "description": "Production-level Online Doctor Appointment & Telemedicine Platform",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run server\" \"npm run client\"",
    "start": "npm run start --workspace=server",
    "build": "npm run build --workspace=client",
    "client": "npm run dev --workspace=client",
    "server": "npm run dev --workspace=server",
    "seed": "npm run seed --workspace=server",
    "test": "npm run test --workspace=server",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
