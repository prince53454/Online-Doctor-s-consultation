# Client Environment Variables
VITE_API_URL=/api
VITE_SOCKET_URL=
# Opt in only for preview data. Checkout always requires the backend.
VITE_DEMO_MODE=false
VITE_BACKEND_URL=http://127.0.0.1:5000

# Server Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/mediconnect_pro
# Tests clean collections; always use a separate database.
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/mediconnect_test
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRE=7d

# Optional Integrations
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
DAILY_API_KEY=
DAILY_DOMAIN=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
